# ── REQUIRED ──────────────────────────────────────────────────────────────────
# Your location (used for weather + day/night detection)
LATITUDE=49.5535
LONGITUDE=25.5948

# ── DEPLOY (only needed for self-hosted RPi deployment) ───────────────────────
APP_IMAGE=ghcr.io/REPLACE_ME/led-matrix-idotmatrix-app:main
SIDECAR_IMAGE=ghcr.io/REPLACE_ME/led-matrix-idotmatrix-sidecar:main
RPI_HOST=pi@raspberrypi.local
RPI_DIR=$HOME/led-matrix

# ── OPTIONAL (defaults shown, uncomment to override) ──────────────────────────
# TZ=Europe/Kiev
# INTERVAL_SECONDS=600
# SHOW_CLOCK=true           # temperature left + clock right on one line; false = temperature only
# (set TZ above, otherwise the clock shows UTC)
# SIDECAR_URL=http://127.0.0.1:8765
# SCAN_TIMEOUT=15
# DEVICE_NAME_PREFIX=IDM
# ── Linux/BlueZ sidecar (optional) ────────────────────────────────────────────
# BLE_ADAPTER_MAC=5C:F3:70:9A:97:27   # pin the panel to one Bluetooth adapter
# BLE_PANEL_ADDRESS=3E:CF:3A:3B:93:62 # drop a stale link to the panel on startup
# BLE_FRAGMENT_SIZE=                  # cap BLE write size (defaults to the negotiated MTU)
